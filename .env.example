# Copy this file to .env and fill in your own values.
# Never commit your real .env file.

# Port the Express server runs on
PORT=3000

# Optional: Google Gemini API key for the AI chatbot.
# If left empty, the chatbot automatically falls back to a local
# rule-based response system so it still works as a full demo.
GEMINI_API_KEY=

# Gemini model to use (only relevant if GEMINI_API_KEY is set)
GEMINI_MODEL=gemini-1.5-flash

# Simple password used to access /admin (appointment dashboard).
# Change this before deploying anywhere public.
ADMIN_PASSWORD=changeme123
